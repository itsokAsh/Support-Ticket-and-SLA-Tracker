# PostgreSQL connection string
DATABASE_URL="postgresql://sla_user:sla_password@localhost:5432/sla_tracker?schema=public"

# JWT secret for signing tokens
JWT_SECRET="change-me-to-a-secure-random-string"

# Business timezone for SLA calculations (IANA timezone identifier)
BUSINESS_TIMEZONE="Asia/Kolkata"

# Server port
PORT=4000
