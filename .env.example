# The port the API binds to
PORT=4000

# PostgreSQL connection string
# Standard format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://sla_user:sla_password@localhost:5434/sla_tracker?schema=public

# Secret key for signing JSON Web Tokens
JWT_SECRET=super_secret_development_key

# Timezone used for all business hours math (e.g. Asia/Kolkata, America/New_York)
BUSINESS_TIMEZONE=Asia/Kolkata
