{
  "name": "support-ticket-sla-tracker",
  "version": "1.0.0",
  "description": "Support Ticket & SLA Tracker with business-hours-only SLA calculations",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "gendb": "bunx prisma migrate deploy && bunx prisma generate && bun run seed",
    "migrate": "bunx prisma migrate dev",
    "seed": "bunx prisma db seed",
    "test": "bun test",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "bun prisma/seed.ts"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "bun-types": "^1.4.0",
    "eslint": "^8.57.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "graphql": "^16.9.0",
    "graphql-yoga": "^5.7.0",
    "jose": "^6.0.0",
    "prisma": "^6.0.0",
    "zod": "^3.23.0"
  }
}
